+// WASI (tinue's in-browser build): the host writes TEI lines into a buffer from tk_alloc and calls tk_command; output
+// goes to stdout (fd 1), which the host captures. A "go" runs to completion before tk_command returns.
+#[cfg(target_os = "wasi")]
+mod wasi {
+    use super::TeiHandler;
+    use std::cell::RefCell;
+
+    thread_local! {
+        static HANDLER: RefCell<Option<TeiHandler>> = const { RefCell::new(None) };
+    }
+
+    #[unsafe(no_mangle)]
+    pub extern "C" fn tk_alloc(len: usize) -> *mut u8 {
+        let mut buf = Vec::<u8>::with_capacity(len.max(1));
+        let ptr = buf.as_mut_ptr();
+        std::mem::forget(buf);
+        ptr
+    }
+
+    #[unsafe(no_mangle)]
+    pub extern "C" fn tk_free(ptr: *mut u8, len: usize) {
+        unsafe { drop(Vec::from_raw_parts(ptr, 0, len.max(1))) };
+    }
+
+    /// # Safety
+    /// `ptr` must point to `len` bytes of UTF-8 from tk_alloc.
+    #[unsafe(no_mangle)]
+    pub unsafe extern "C" fn tk_command(ptr: *const u8, len: usize) -> i32 {
+        let line = unsafe { std::str::from_utf8_unchecked(std::slice::from_raw_parts(ptr, len)) };
+        HANDLER.with(|h| {
+            let mut h = h.borrow_mut();
+            let handler = h.get_or_insert_with(TeiHandler::new);
+            let quit = !handler.dispatch(line, std::time::Instant::now());
+            use std::io::Write;
+            let _ = std::io::stdout().flush();
+            quit as i32
+        })
+    }
+}
