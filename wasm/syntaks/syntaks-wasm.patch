+// WASI (tinue's in-browser build): no threads, so the search runs inline on the calling thread, with one
+// ThreadData kept for the engine's lifetime. Same interface as the threaded searcher; Threads is fixed at 1.
+#[cfg(target_os = "wasi")]
+pub struct Searcher {
+    shared_ctx: Arc<SharedContext>,
+    data: ThreadData<'static>,
+}
+
+#[cfg(target_os = "wasi")]
+impl Searcher {
+    pub fn new(tt_size_mib: usize) -> Self {
+        let hist: &'static History = Box::leak(History::boxed());
+        let corrhist: &'static CorrectionHistory = Box::leak(CorrectionHistory::boxed());
+        let mut shared_ctx = SharedContext::new(tt_size_mib);
+        shared_ctx.set_threads(1);
+        Self {
+            shared_ctx: Arc::new(shared_ctx),
+            data: ThreadData::new(0, hist, corrhist),
+        }
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    pub fn start_search(
+        &mut self,
+        pos: &Position,
+        new_key_history: &[u64],
+        start_time: Instant,
+        limits: Limits,
+        max_depth: i32,
+        moves_to_search: &[Move],
+        moves_to_exclude: &HashSet<Move>,
+        options: &TeiOptions,
+    ) {
+        self.modify_shared_ctx(|ctx| {
+            ctx.init_search(options, start_time, limits, 1);
+        });
+
+        let root_moves = init_root_moves(pos, moves_to_search, moves_to_exclude);
+        let multipv = options.multipv.min(root_moves.len());
+
+        let ctx = SearchContext::new(
+            max_depth,
+            multipv,
+            *pos,
+            Arc::new(root_moves),
+            Arc::new(new_key_history.to_vec()),
+        );
+
+        run_search(self.shared_ctx.clone(), &ctx, &mut self.data);
+    }
+
+    pub fn stop(&mut self) {
+        self.shared_ctx.stop();
+    }
+
+    pub fn is_searching(&self) -> bool {
+        self.shared_ctx.is_searching()
+    }
+
+    pub fn wait(&self) {}
+
+    #[must_use]
+    pub fn total_nodes(&self) -> usize {
+        self.shared_ctx.total_nodes()
+    }
+
+    fn modify_shared_ctx<F>(&mut self, func: F)
+    where
+        F: Fn(&mut SharedContext),
+    {
+        let ctx =
+            Arc::get_mut(&mut self.shared_ctx).expect("shared search context still referenced by a search thread");
+        func(ctx);
+    }
+
+    pub fn reset(&mut self) {
+        self.modify_shared_ctx(|ctx| {
+            ctx.tt.clear(1);
+        });
+        self.data.corrhist.clear();
+        self.data.history.clear();
+        self.data.killers.fill(Default::default());
+    }
+
+    pub fn set_tt_size(&mut self, size_mib: usize) {
+        self.modify_shared_ctx(|ctx| {
+            ctx.tt.resize(size_mib, 1);
+        });
+    }
+
+    pub fn set_threads(&mut self, _count: u32) {}
+}
